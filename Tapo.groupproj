<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{163D0533-FE79-4CD3-A227-E0C175460037}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Demo\Scan.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Scan">
        <MSBuild Projects="Demo\Scan.dproj"/>
    </Target>
    <Target Name="Scan:Clean">
        <MSBuild Projects="Demo\Scan.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Scan:Make">
        <MSBuild Projects="Demo\Scan.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Scan"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Scan:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Scan:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
